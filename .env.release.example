# Credentials for bin/release.sh (npm run release).
# Copy to .env.release and fill in. .env.release is git-ignored and excluded
# from every package by .distignore. Quote values that contain spaces or $.

# Freemius > Product > Settings > API & Keys > API Bearer Authorization token.
FS_API_TOKEN=

# Freemius product ID. Leave empty to use the id in includes/licensing.php.
FS_PRODUCT_ID=

# WordPress.org SVN credentials (the SVN password from
# https://profiles.wordpress.org/me/profile/edit/group/3/?screen=svn-password).
# Leave both empty to use svn's cached credentials or be prompted at commit time.
SVN_USERNAME=
SVN_PASSWORD=
