# Files and directories excluded from the Divi Marketplace package.
# Used by build-marketplace.sh together with .marketplace-distignore.

# Credentials - must never ship
.env
.env.*

# Version control / CI
.git
.gitignore
.gitattributes
.github
.distignore

# Edition sources and build scripts (they never ship)
marketplace
marketplace-assets
.marketplace-distignore
build-marketplace.sh

# Source (compiled output in assets/ is what ships)
dev
node_modules
vite.config.js
tailwind.config.js
postcss.config.js
package.json
package-lock.json
yarn.lock

# Tooling / docs
/docs
/bin
composer.json
composer.lock
vendor
phpcs.xml
phpcs.xml.dist
CLAUDE.md
AGENTS.md
QWEN.md
.claude
.agents
.codex
.kiro
.vscode
.editorconfig

# OS
.DS_Store
Thumbs.db
